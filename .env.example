# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Anthropic API key (needed from milestone B4)
ANTHROPIC_API_KEY=

# Optional overrides
RA_CHECKER_MODEL=claude-opus-5-5
RA_LEAN_PROJECT_DIR=lean
RA_LEAN_TIMEOUT_S=120
RA_LLM_TIMEOUT_S=300
# auto | repl | cli | docker (docker: see "Optional: run Lean in a Docker sandbox" in README.md)
RA_LEAN_RUNNER=auto
RA_LEAN_DOCKER_IMAGE=ra-checker-lean:v4.36.0
RA_LOG_LEVEL=INFO
